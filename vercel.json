{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/CSS/(.*)", "destination": "/CSS/estilos.css" },
    { "source": "/JAVASCRIPT/(.*)", "destination": "/JAVASCRIPT/app.js" },
    { "source": "/(.*)", "destination": "/HTML/index.html" }
  ]
}
